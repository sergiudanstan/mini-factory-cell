{
  "name": "mini-factory-cell",
  "version": "0.1.0",
  "private": true,
  "description": "Browser digital twin of a small-factory assembly cell: 3 vibratory bowl feeders, an 8-station dial, a delta robot and an Epson T3-B401S SCARA",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/build.mjs && node tests/run.mjs",
    "perturb": "node tests/run.mjs --perturb",
    "shots": "node tools/shots.mjs",
    "stats": "node tools/stats.mjs",
    "record": "node tools/record.mjs",
    "smoke": "node tests/smoke.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.65.0"
  }
}
